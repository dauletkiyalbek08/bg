# Local single-instance demo. Never put real student data in the demo.
BAGDAR_MODE=demo
BAGDAR_BACKEND=sqlite
# BAGDAR_DATA_DIR=.data
# Canonical browser origin, required behind a production reverse proxy.
# BAGDAR_APP_ORIGIN=https://your-app.example

# Supabase backend (do not combine with demo mode):
# BAGDAR_MODE=private
# BAGDAR_BACKEND=supabase
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Bootstrap only. Supply securely; never commit values or print them:
# BAGDAR_BOOTSTRAP_LOGIN=
# BAGDAR_BOOTSTRAP_PASSWORD=
