{
  "name": "bagdar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "node --import tsx scripts/seed.ts",
    "format": "prettier --write .",
    "seed:bootstrap": "node --import tsx scripts/seed.ts --bootstrap",
    "test:netlify": "vitest run --config vitest.netlify.config.ts"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.7",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.89.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.26",
    "next": "16.4.4",
    "pdf-lib": "^1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.6.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@netlify/plugin-nextjs": "5.16.5",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.4.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "type": "module"
}
